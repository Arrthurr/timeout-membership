# Resend contact form delivery
# Set these in Vercel Project Settings > Environment Variables.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Cloudflare Turnstile spam protection
# VITE_ variables are exposed to the browser by design.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis rate limiting for the contact form (required in production)
# Create a free database at https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
